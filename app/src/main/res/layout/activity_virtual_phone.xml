<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/phone_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/vm_desktop_bg">

    <!-- Virtual Phone Screen Viewport -->
    <LinearLayout
        android:id="@+id/vm_viewport"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- Top Status Bar -->
        <LinearLayout
            android:id="@+id/vm_status_bar"
            android:layout_width="match_parent"
            android:layout_height="28dp"
            android:background="@color/vm_status_bar"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="12dp"
            android:paddingEnd="12dp">

            <TextView
                android:id="@+id/status_clock"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="12:00"
                android:textColor="@color/text_primary"
                android:textSize="12sp"
                android:textStyle="bold" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/status_root_icon"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:background="@drawable/bg_chip"
                android:paddingStart="4dp"
                android:paddingTop="1dp"
                android:paddingEnd="4dp"
                android:paddingBottom="1dp"
                android:text="#"
                android:textColor="@color/root_active"
                android:textSize="11sp"
                android:textStyle="bold"
                android:visibility="gone" />

            <ImageView
                android:id="@+id/status_wifi_icon"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_marginEnd="6dp"
                android:src="@drawable/ic_wifi"
                app:tint="@color/primary" />

            <TextView
                android:id="@+id/status_battery_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="4dp"
                android:text="100%"
                android:textColor="@color/text_primary"
                android:textSize="11sp" />

            <ImageView
                android:id="@+id/status_battery_icon"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@drawable/ic_battery"
                app:tint="@color/text_primary" />
        </LinearLayout>

        <!-- Main Display Content Area (Desktop or Running App) -->
        <FrameLayout
            android:id="@+id/vm_content_area"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <!-- 1. Virtual Desktop / Launcher -->
            <LinearLayout
                android:id="@+id/vm_launcher_desktop"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:padding="16dp"
                android:visibility="visible">

                <!-- Widget: Clock & Date -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:gravity="center"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/desktop_big_clock"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="12:00"
                        android:textColor="@color/text_primary"
                        android:textSize="56sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/desktop_date_text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Tuesday, November 17"
                        android:textColor="@color/primary"
                        android:textSize="14sp" />
                </LinearLayout>

                <!-- Search Widget -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:layout_marginStart="8dp"
                    android:layout_marginTop="24dp"
                    android:layout_marginEnd="8dp"
                    android:background="@drawable/bg_chip"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp">

                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:src="@drawable/ic_apps"
                        app:tint="@color/text_secondary" />

                    <EditText
                        android:id="@+id/edit_search_apps"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:background="@null"
                        android:hint="@string/search_apps"
                        android:imeOptions="actionSearch"
                        android:inputType="text"
                        android:maxLines="1"
                        android:textColor="@color/text_primary"
                        android:textColorHint="@color/text_secondary"
                        android:textSize="13sp" />
                </LinearLayout>

                <!-- Grid of Installed Apps -->
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/recycler_desktop_apps"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_marginTop="20dp"
                    android:layout_weight="1"
                    android:clipToPadding="false"
                    android:overScrollMode="never" />

                <!-- Bottom Dock of Favorite Apps -->
                <LinearLayout
                    android:id="@+id/dock_favorites"
                    android:layout_width="match_parent"
                    android:layout_height="68dp"
                    android:layout_marginStart="12dp"
                    android:layout_marginEnd="12dp"
                    android:layout_marginBottom="4dp"
                    android:background="@drawable/bg_card_cyber"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <!-- Favorite: Files -->
                    <ImageView
                        android:id="@+id/dock_app_files"
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:layout_margin="8dp"
                        android:background="@drawable/bg_app_icon"
                        android:clickable="true"
                        android:focusable="true"
                        android:padding="10dp"
                        android:src="@drawable/ic_folder"
                        app:tint="@color/primary" />

                    <!-- Favorite: Browser -->
                    <ImageView
                        android:id="@+id/dock_app_browser"
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:layout_margin="8dp"
                        android:background="@drawable/bg_app_icon"
                        android:clickable="true"
                        android:focusable="true"
                        android:padding="10dp"
                        android:src="@drawable/ic_browser"
                        app:tint="@color/primary" />

                    <!-- Favorite: Terminal -->
                    <ImageView
                        android:id="@+id/dock_app_terminal"
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:layout_margin="8dp"
                        android:background="@drawable/bg_app_icon"
                        android:clickable="true"
                        android:focusable="true"
                        android:padding="10dp"
                        android:src="@drawable/ic_terminal"
                        app:tint="@color/primary" />

                    <!-- Favorite: Settings -->
                    <ImageView
                        android:id="@+id/dock_app_settings"
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:layout_margin="8dp"
                        android:background="@drawable/bg_app_icon"
                        android:clickable="true"
                        android:focusable="true"
                        android:padding="10dp"
                        android:src="@drawable/ic_settings"
                        app:tint="@color/primary" />
                </LinearLayout>
            </LinearLayout>

            <!-- 2. Running App Host Container -->
            <FrameLayout
                android:id="@+id/vm_running_app_container"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@color/background"
                android:visibility="gone" />

            <!-- 3. Recents / Multitasking Carousel View -->
            <LinearLayout
                android:id="@+id/vm_recents_view"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@color/scrim_black_80"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="20dp"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Active Tasks"
                    android:textColor="@color/text_primary"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/recycler_recents"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_marginTop="16dp"
                    android:layout_marginBottom="16dp"
                    android:layout_weight="1"
                    android:clipToPadding="false" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_clear_all_tasks"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:backgroundTint="@color/surface_elevated"
                    android:text="Clear All"
                    android:textColor="@color/text_primary"
                    app:cornerRadius="20dp"
                    app:icon="@drawable/ic_delete"
                    app:iconTint="@color/text_primary" />
            </LinearLayout>

            <!-- 4. Pull-down Quick Settings Shade -->
            <LinearLayout
                android:id="@+id/vm_quick_settings_shade"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_card_cyber"
                android:clickable="true"
                android:elevation="12dp"
                android:focusable="true"
                android:orientation="vertical"
                android:padding="16dp"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/qs_date_text"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Quick Settings"
                        android:textColor="@color/text_primary"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <ImageButton
                        android:id="@+id/qs_btn_close"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:background="?selectableItemBackgroundBorderless"
                        android:src="@drawable/ic_back"
                        app:tint="@color/text_secondary" />
                </LinearLayout>

                <!-- Quick Toggles Grid -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:orientation="horizontal">

                    <!-- WiFi Toggle -->
                    <LinearLayout
                        android:id="@+id/qs_toggle_wifi"
                        android:layout_width="0dp"
                        android:layout_height="64dp"
                        android:layout_marginEnd="6dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_chip"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center"
                        android:orientation="vertical">

                        <ImageView
                            android:id="@+id/qs_icon_wifi"
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:src="@drawable/ic_wifi"
                            app:tint="@color/primary" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="WiFi"
                            android:textColor="@color/text_primary"
                            android:textSize="11sp" />
                    </LinearLayout>

                    <!-- Root Toggle -->
                    <LinearLayout
                        android:id="@+id/qs_toggle_root"
                        android:layout_width="0dp"
                        android:layout_height="64dp"
                        android:layout_marginStart="3dp"
                        android:layout_marginEnd="3dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_chip"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center"
                        android:orientation="vertical">

                        <ImageView
                            android:id="@+id/qs_icon_root"
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:src="@drawable/ic_shield"
                            app:tint="@color/root_active" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="Root SU"
                            android:textColor="@color/text_primary"
                            android:textSize="11sp" />
                    </LinearLayout>

                    <!-- Location Toggle -->
                    <LinearLayout
                        android:id="@+id/qs_toggle_location"
                        android:layout_width="0dp"
                        android:layout_height="64dp"
                        android:layout_marginStart="3dp"
                        android:layout_marginEnd="3dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_chip"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center"
                        android:orientation="vertical">

                        <ImageView
                            android:id="@+id/qs_icon_location"
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:src="@drawable/ic_sensors"
                            app:tint="@color/primary" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="Mock GPS"
                            android:textColor="@color/text_primary"
                            android:textSize="11sp" />
                    </LinearLayout>

                    <!-- Rotate Toggle -->
                    <LinearLayout
                        android:id="@+id/qs_toggle_rotate"
                        android:layout_width="0dp"
                        android:layout_height="64dp"
                        android:layout_marginStart="6dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_chip"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center"
                        android:orientation="vertical">

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:src="@drawable/ic_refresh"
                            app:tint="@color/text_primary" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="Rotate"
                            android:textColor="@color/text_primary"
                            android:textSize="11sp" />
                    </LinearLayout>

                </LinearLayout>

            </LinearLayout>

        </FrameLayout>

        <!-- Bottom Navigation Bar (Back, Home, Recents) -->
        <LinearLayout
            android:id="@+id/vm_nav_bar"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="@color/vm_nav_bar"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <!-- Back Button -->
            <ImageButton
                android:id="@+id/nav_btn_back"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="?selectableItemBackgroundBorderless"
                android:contentDescription="Back"
                android:src="@drawable/ic_back"
                app:tint="@color/text_primary" />

            <!-- Home Button -->
            <ImageButton
                android:id="@+id/nav_btn_home"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="?selectableItemBackgroundBorderless"
                android:contentDescription="Home"
                android:src="@drawable/ic_home"
                app:tint="@color/text_primary" />

            <!-- Recents Button -->
            <ImageButton
                android:id="@+id/nav_btn_recents"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="?selectableItemBackgroundBorderless"
                android:contentDescription="Recents"
                android:src="@drawable/ic_recents"
                app:tint="@color/text_primary" />
        </LinearLayout>

    </LinearLayout>

    <!-- Floating Assistant Ball (V-Ball) - Draggable -->
    <ImageView
        android:id="@+id/v_ball"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_gravity="end|center_vertical"
        android:layout_marginEnd="8dp"
        android:background="@drawable/bg_floating_ball"
        android:clickable="true"
        android:elevation="16dp"
        android:focusable="true"
        android:padding="11dp"
        android:src="@drawable/ic_phone_android"
        app:tint="@color/primary" />

</FrameLayout>
